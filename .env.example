IMAGE_TAG=latest
POSTGRES_DB=paceapp
POSTGRES_USER=paceapp_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_USERNAME=dutu
AUTH_DISPLAY_NAME=Dutu
AUTH_PASSWORD_SHA256=replace-with-sha256-of-password
AUTH_SIGNING_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
HERMES_BASE_URL=http://host.docker.internal:8642
HERMES_API_KEY=replace-with-the-same-API_SERVER_KEY-from-hermes-env
TOKEN_TTL_DAYS=90
