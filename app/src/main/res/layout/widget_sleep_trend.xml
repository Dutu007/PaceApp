<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sleep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_sleep_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_indigo" />

        <TextView
            android:id="@+id/widget_sleep_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="睡眠"
            android:textColor="#FF131C24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_indigo"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="待同步"
            android:textColor="#FF5B5CE2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sleep_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_muted"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text=""
            android:textColor="#FFD97706"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_sleep_window"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_muted"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text=""
            android:textColor="#FF5A6B78"
            android:textSize="10sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/widget_sleep_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_muted"
            android:maxLines="1"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="刷新"
            android:textColor="#FF5A6B78"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_sleep_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:contentDescription="近7天睡眠时长图表"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_sleep_footer_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="支持 COROS 手表 / 手动同步"
            android:textColor="#FF5A6B78"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_sleep_footer_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="等待同步"
            android:textColor="#FF5A6B78"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
